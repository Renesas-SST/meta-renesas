---
 mlinux/moal_shim.c | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/mlinux/moal_shim.c b/mlinux/moal_shim.c
index 645f56c..7452c51 100644
--- a/mlinux/moal_shim.c
+++ b/mlinux/moal_shim.c
@@ -80,6 +80,10 @@ typedef struct _moal_lock {
 	spinlock_t lock;
 	/** Flags */
 	unsigned long flags;
+	/** Per-instance lockdep class key */
+#ifdef CONFIG_LOCKDEP
+	struct lock_class_key dep_key;
+#endif
 } moal_lock;
 
 /********************************************************
@@ -795,7 +799,14 @@ mlan_status moal_init_lock(t_void *pmoal, t_void **pplock)
 	mlock = kmalloc(sizeof(moal_lock), GFP_ATOMIC);
 	if (!mlock)
 		return MLAN_STATUS_FAILURE;
+
 	spin_lock_init(&mlock->lock);
+	mlock->flags = 0;
+
+#ifdef CONFIG_LOCKDEP
+	lockdep_register_key(&mlock->dep_key);
+	lockdep_set_class(&mlock->lock, &mlock->dep_key);
+#endif
 	*pplock = (t_void *)mlock;
 
 	atomic_inc(&handle->lock_count);
@@ -816,9 +827,14 @@ mlan_status moal_free_lock(t_void *pmoal, t_void *plock)
 	moal_handle *handle = (moal_handle *)pmoal;
 	moal_lock *mlock = plock;
 
+	if (!mlock)
+		return MLAN_STATUS_SUCCESS;
+
+#ifdef CONFIG_LOCKDEP
+	lockdep_unregister_key(&mlock->dep_key);
+#endif
 	kfree(mlock);
-	if (mlock)
-		atomic_dec(&handle->lock_count);
+	atomic_dec(&handle->lock_count);
 
 	return MLAN_STATUS_SUCCESS;
 }
@@ -832,7 +848,7 @@ mlan_status moal_free_lock(t_void *pmoal, t_void *plock)
  *  @return         MLAN_STATUS_SUCCESS or MLAN_STATUS_FAILURE
  */
 mlan_status moal_spin_lock(t_void *pmoal, t_void *plock)
-	__acquires(&plock->lock)
+	__acquires(&((moal_lock *)plock)->lock)
 {
 	moal_lock *mlock = plock;
 	unsigned long flags = 0;
@@ -850,7 +866,7 @@ mlan_status moal_spin_lock(t_void *pmoal, t_void *plock)
  *  @return         MLAN_STATUS_SUCCESS or MLAN_STATUS_FAILURE
  */
 mlan_status moal_spin_unlock(t_void *pmoal, t_void *plock)
-	__releases(&plock->lock)
+	__releases(&((moal_lock *)plock)->lock)
 {
 	moal_lock *mlock = (moal_lock *)plock;
 	spin_unlock_irqrestore(&mlock->lock, mlock->flags);
-- 
