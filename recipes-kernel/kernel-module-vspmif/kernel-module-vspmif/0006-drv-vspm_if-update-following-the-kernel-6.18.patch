 vspm_if-module/files/vspm_if/drv/Makefile       | 2 ++
 vspm_if-module/files/vspm_if/drv/vspm_if_main.c | 3 +--
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/vspm_if-module/files/vspm_if/drv/Makefile b/vspm_if-module/files/vspm_if/drv/Makefile
index bf082d7..a149380 100644
