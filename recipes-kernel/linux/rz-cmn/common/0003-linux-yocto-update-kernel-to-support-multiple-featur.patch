+static const struct of_device_id rsci_of_match[] = {
+	/* RSCI SPI on RZ/V2H and similar SoCs */
+	{ .compatible = "renesas,rsci-spi", .data = &rsci_common_ops },
+	{ /* sentinel */ }
+};
+
+MODULE_DEVICE_TABLE(of, rsci_of_match);
