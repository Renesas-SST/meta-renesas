+void rzg2l_cru_suspend_stop_streaming(struct rzg2l_cru_dev *cru)
+{
+	int retries = 0;
+
+	/* Disable and clear the interrupt */
+	rzg2l_cru_write(cru, CRUnIE, 0);
+	rzg2l_cru_write(cru, CRUnINTS, 0);
