+		usleep_range(10, 20);
+	};
+	/* Cancel the AXI bus stop request */
+	rzg2l_cru_write(cru, AMnAXISTP, 0);
+
+	/* Release all active buffers */
+	return_unused_buffers(cru, VB2_BUF_STATE_ERROR);
+
+	cru->suspend = true;
+	rzg2l_cru_set_stream(cru, 0);
