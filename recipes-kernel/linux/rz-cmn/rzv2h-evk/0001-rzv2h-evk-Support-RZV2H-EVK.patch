+
+static void ostm_clksrc_resume(struct clocksource *c)
 {
+	struct ostm_clksrc *ostm_clksrc =
+		container_of(c, struct ostm_clksrc, clksrc);
+	struct timer_of *to = ostm_clksrc->to;
