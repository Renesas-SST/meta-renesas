+#define XSPI_CCCTL1_CAADDSIZE(val)	(((val) & 0x07) << 2)
+#define XSPI_CCCTL1_CADARASIZE(val)	(((val) & 0x0f) << 5)
+#define XSPI_CCCTL1_CAWRLATE(val)	(((val) & 0x1f) << 16)
+#define XSPI_CCCTL1_CARDLATE(val)	(((val) & 0x1f) << 24)
+
