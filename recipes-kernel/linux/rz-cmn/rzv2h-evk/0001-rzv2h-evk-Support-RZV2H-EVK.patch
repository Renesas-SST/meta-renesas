+				ssiu32: ssiu-14 {
+					dmas = <&dmac1 0x381D7D>, <&dmac2 0x391D7E>;
+					dma-names = "tx", "rx";
+				};
+				ssiu33: ssiu-15 {
+					dmas = <&dmac1 0x3A1D7F>, <&dmac2 0x3B1D80>;
+					dma-names = "tx", "rx";
+				};
+				ssiu40: ssiu-16 {
+					dmas = <&dmac1 0x3C1D81>, <&dmac2 0x3D1D82>;
+					dma-names = "tx", "rx";
+				};
+				ssiu41: ssiu-17 {
+					dmas = <&dmac1 0x3E1D83>, <&dmac2 0x3F1D84>;
+					dma-names = "tx", "rx";
+				};
+				ssiu42: ssiu-18 {
+					dmas = <&dmac1 0x401D85>, <&dmac2 0x411D86>;
+					dma-names = "tx", "rx";
+				};
+				ssiu43: ssiu-19 {
+					dmas = <&dmac1 0x421D87>, <&dmac2 0x431D88>;
+					dma-names = "tx", "rx";
+				};
+				ssiu50: ssiu-20 {
+					dmas = <&dmac1 0x441D89>, <&dmac2 0x451D8A>;
+					dma-names = "tx", "rx";
+				};
+				ssiu60: ssiu-21 {
+					dmas = <&dmac1 0x461D8B>, <&dmac2 0x471D8C>;
+					dma-names = "tx","rx";
+				};
+				ssiu70: ssiu-22 {
+					dmas = <&dmac1 0x481D8D>, <&dmac2 0x491D8E>;
+					dma-names = "tx", "rx";
+				};
+				ssiu80: ssiu-23 {
+					dmas = <&dmac1 0x4A1D8F>, <&dmac2 0x4B1D90>;
+					dma-names = "tx", "rx";
+				};
+				ssiu90: ssiu-24 {
+					dmas = <&dmac1 0x4C1D91>, <&dmac2 0x4D1D92>;
+					dma-names = "tx", "rx";
+				};
+				ssiu91: ssiu-25 {
+					dmas = <&dmac1 0x4E1D93>, <&dmac2 0x4F1D94>;
+					dma-names = "tx", "rx";
+				};
+				ssiu92: ssiu-26 {
+					dmas = <&dmac1 0x501D95>, <&dmac2 0x511D96>;
+					dma-names = "tx", "rx";
+				};
+				ssiu93: ssiu-27 {
+					dmas = <&dmac1 0x521D97>, <&dmac2 0x531D98>;
+					dma-names = "tx", "rx";
+				};
+			};
+
+			rcar_sound,spdif {
+				spdif0: spdif-0 {
+					interrupts = <GIC_SPI 899 IRQ_TYPE_LEVEL_HIGH>;
+					dmas = <&dmac1 0x011D9A>, <&dmac2 0x001D99>;
