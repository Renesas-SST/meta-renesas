+static void renesas_rzv2h_eqos_fix_speed(void *priv, unsigned int speed, unsigned int mode)
+{
+	struct renesas_rzv2h_eqos *eqos = priv;
+	unsigned long rate = 125000000;
+	int err;
+	struct clk *parent;
+
+	parent = clk_get_parent(eqos->clk_tx);
+	parent = clk_get_parent(parent);
+
+	switch (speed) {
+	case SPEED_1000:
+		rate = 125000000;
+		break;
+
+	case SPEED_100:
+		rate = 25000000;
+		break;
+
+	case SPEED_10:
+		rate = 2500000;
+		break;
+
+	default:
+		dev_err(eqos->dev, "invalid speed %u\n", speed);
+		break;
+	}
+
+	err = clk_set_rate(parent, rate);
+	if (err < 0)
+		dev_err(eqos->dev, "failed to set TX rate: %d\n", err);
+}
+
+static int renesas_rzv2h_eqos_init(struct platform_device *pdev, void *priv)
+{
+	struct renesas_rzv2h_eqos *eqos = priv;
+	unsigned long rate;
+	u32 value;
+
+	rate = clk_get_rate(eqos->clk_slave);
+	value = (rate / 1000000) - 1;
+	writel(value, eqos->regs + GMAC_1US_TIC_COUNTER);
+
+	return 0;
+}
