From b058ce3f136a9d3d997327802de7b59fefa13f17 Mon Sep 17 00:00:00 2001
From: Quoc Trinh <quoc.trinh.fz@renesas.com>
Date: Wed, 21 Oct 2026 18:27:06 +0700
Subject: [PATCH] fix(rcar4): register OP-TEE PM hooks only when BL32 is
 present

With SPD=opteed, bl31_plat_runtime_setup() always chained the OP-TEE
PM hooks into the platform PM ops. When BL2/U-Boot does not hand over a
BL32 image (for example Sparrow-Hawk booting without OP-TEE),
opteed_setup() fails and leaves optee_vector_table NULL, but the hooks
stay registered. On PSCI CPU_ON, opteed_cpu_on_finish_handler() then
enters an uninitialised OP-TEE context and the secondary core hangs,
so Linux only brings up CPU0.

Chain the OP-TEE hooks only when a BL32 entry point was provided and
fall back to the platform rcar_pm otherwise.

Upstream-Status: Pending
Signed-off-by: Quoc Trinh <quoc.trinh.fz@renesas.com>
---
 plat/renesas/rcar_gen4/bl31_plat_setup.c | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/plat/renesas/rcar_gen4/bl31_plat_setup.c b/plat/renesas/rcar_gen4/bl31_plat_setup.c
index 97ff2fd42..d3f510253 100644
--- a/plat/renesas/rcar_gen4/bl31_plat_setup.c
+++ b/plat/renesas/rcar_gen4/bl31_plat_setup.c
@@ -129,19 +129,27 @@ void bl31_platform_setup(void)
 #ifdef SPD_opteed
 extern const spd_pm_ops_t opteed_pm;
 static spd_pm_ops_t rcar_opteed_pm;
+#endif
 
-#else
 const spd_pm_ops_t rcar_pm = {
 	.svc_migrate_info = rcar_pwrc_cpu_migrate_info,
 };
-#endif
 
 void bl31_plat_runtime_setup(void)
 {
 #ifdef SPD_opteed
-	memcpy(&rcar_opteed_pm, &opteed_pm, sizeof(rcar_opteed_pm));
-	rcar_opteed_pm.svc_migrate_info = rcar_pwrc_cpu_migrate_info;
-	psci_register_spd_pm_hook(&rcar_opteed_pm);
+	/*
+	 * Only chain the OP-TEE PM hooks when BL2/U-Boot actually handed over
+	 * a BL32 image; otherwise opteed_setup() failed and its hooks would
+	 * enter an uninitialised OP-TEE context on CPU_ON.
+	 */
+	if (bl31_plat_get_next_image_ep_info(SECURE) != NULL) {
+		memcpy(&rcar_opteed_pm, &opteed_pm, sizeof(rcar_opteed_pm));
+		rcar_opteed_pm.svc_migrate_info = rcar_pwrc_cpu_migrate_info;
+		psci_register_spd_pm_hook(&rcar_opteed_pm);
+	} else {
+		psci_register_spd_pm_hook(&rcar_pm);
+	}
 #else
 	psci_register_spd_pm_hook(&rcar_pm);
 #endif
-- 
